# Copy this file to .env and fill in real values.
# .env is gitignored — do NOT commit it.

# Required only when running spikes with --real-llm, or the live crew daemon
# with SFC_MODEL=real. Get a key at: https://console.anthropic.com/settings/keys
# New accounts include $5 of free credit, more than enough for the
# Part 7 spike (~$0.06 to run all three candidates at claude-haiku-4-5).
ANTHROPIC_API_KEY=sk-ant-api03-replace-me

# ── Live crew daemon (python -m solo_founder_crew.app) ──────────────────────
# See docs/running-the-crew.md. Channel IDs go in crew.toml (copy from
# crew.toml.example); secrets + infra go here.

# Discord bot token (Developer Portal → your app → Bot → Reset Token).
DISCORD_BOT_TOKEN=replace-me

# Your Discord server id — right-click the server icon → Copy Server ID
# (needs Developer Mode: User Settings → Advanced → Developer Mode).
# Slash commands are registered to this server so they appear instantly.
SFC_GUILD_ID=000000000000000000

# Which LLM the crew drafts/advises with:
#   mock = offline placeholder text (no API key, free) — fine for wiring/demos
#   real = Anthropic Haiku (needs ANTHROPIC_API_KEY above)
# Set this to "real" for actual drafts and /ask advice.
SFC_MODEL=mock

# Optional overrides (defaults shown):
# SFC_CHECKPOINTER_URL=sqlite:///./data/state.db   # or "memory"
# SFC_BRIEF_PATH=scenarios/fixtures/passly_brief.json
# SFC_CONFIG=crew.toml                    # path to the channel map / crew config
# SFC_AUTO_CHANNELS=true                  # auto-create a channel per role on connect

# ── Optional: CI → Discord PR notifications (channel webhook) ───────────────
# This is a GitHub Actions repo secret (Settings → Secrets), NOT a local var —
# listed here only as a reminder of what the notify workflow needs.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ── Optional: engineering role's pr_tool (M2 Phase 2) ───────────────────────
# Required only when running the engineering Author Flow with the real
# GitHub PR tool (e.g. `python examples/engineering_pr.py --live`).
# The default example uses FakeGitHubAPI and ignores all three vars.
#
# GitHub personal access token with `repo` scope (or the fine-grained
# equivalent: read/write on Contents + Pull requests for the target repo).
# Create at: https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_replace-me
#
# Target repository (owner/name) the engineering role opens PRs against.
# SFC_PR_REPO=liapisn/passly
#
# Branch the PR targets (default "main").
# SFC_PR_BASE_BRANCH=main
