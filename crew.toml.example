# Crew daemon config — copy to crew.toml and edit. Secrets go in .env, not here.
# Resolution: defaults < this file < environment variables.

[crew]
brief = "scenarios/fixtures/passly_brief.json"
model = "mock"                       # "mock" (offline placeholder) | "real" (Anthropic Haiku)
checkpointer = "sqlite:///./data/state.db"   # or "memory"
# guild_id = 123456789012345678      # usually set via SFC_GUILD_ID in .env instead

# Logical channel  ->  Discord channel id. Logical names are the kebab-cased
# role names the runtime emits (engineering, customer-support, …). Enable
# Developer Mode in Discord, right-click a channel → Copy Channel ID.
[channels]
marketing = "000000000000000000"
product = "000000000000000000"
engineering = "000000000000000000"
customer-support = "000000000000000000"
sales = "000000000000000000"
finance = "000000000000000000"

# Optional catch-all if a logical channel isn't mapped above:
# default_channel = "000000000000000000"
