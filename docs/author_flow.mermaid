%% Author Flow — generated by solo_founder_crew.runtime.build_author_graph
%% Regenerate:
%%   .venv/bin/python -c "from solo_founder_crew import *; \
%%     from solo_founder_crew.hitl import FounderDecision; \
%%     role=Role(name='m',goal='x',system_prompt='x', \
%%       decision_rights=DecisionRights(can=('draft_content','revise_content'), \
%%       must_escalate=('final_approval_before_publish',)),tools=('publisher_tool',)); \
%%     async def p(_): return 'ok'; \
%%     tools=ToolRegistry(); tools.register('publisher_tool',p,escalates='final_approval_before_publish'); \
%%     g=build_author_graph(role=role,llm=MockLLM(responses=['x']), \
%%       hitl=ScriptedHITL([FounderDecision(action='approve')]),tools=tools); \
%%     print(g.compiled.get_graph().draw_mermaid())"
---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	draft(draft)
	hitl(hitl)
	revise(revise)
	publish(publish)
	kill(kill)
	exhausted(exhausted)
	__end__([<p>__end__</p>]):::last
	__start__ --> draft;
	draft --> hitl;
	hitl -.-> exhausted;
	hitl -.-> kill;
	hitl -.-> publish;
	hitl -.-> revise;
	revise --> hitl;
	exhausted --> __end__;
	kill --> __end__;
	publish --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
